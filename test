<!-- Bootstrap 5 JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    let hubData = {
        Info: { Name: "", Version: "", Creator: "Hothiptv", ThemeColor: [0, 173, 181] },
        HomeTab: { Introduction: "", Elements: [] },
        Tabs: []
    };

    let tabCollapsedState = {};
    let descExpandedState = {};
    let searchQuery = "";
    let confirmCallback = null;
    let fetchedScriptbloxItems = []; // Lưu trữ danh sách kết quả bóc tách tạm thời

    window.onload = async function() {
        await loadDataFromServer();
    };

    function switchTab(viewName) {
        document.querySelectorAll('.app-view').forEach(view => view.classList.remove('active-view'));
        document.querySelectorAll('.nav-tab-btn').forEach(btn => btn.classList.remove('active'));

        const targetView = document.getElementById(`view-${viewName}`);
        const targetBtn = document.getElementById(`btn-tab-${viewName}`);

        if (targetView) targetView.classList.add('active-view');
        if (targetBtn) targetBtn.classList.add('active');

        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function showToast(message, type = 'success') {
        const wrapper = document.getElementById('toast-wrapper');
        const toast = document.createElement('div');
        toast.className = `toast-custom toast-${type}`;
        
        let icon = '<i class="fa-solid fa-circle-check text-success"></i>';
        if (type === 'error') icon = '<i class="fa-solid fa-circle-xmark text-danger"></i>';
        if (type === 'info') icon = '<i class="fa-solid fa-circle-info text-info"></i>';

        toast.innerHTML = `<div>${icon}</div> <div>${message}</div>`;
        wrapper.appendChild(toast);

        setTimeout(() => toast.classList.add('show'), 15);
        setTimeout(() => {
            toast.classList.remove('show');
            setTimeout(() => toast.remove(), 350);
        }, 3200);
    }

    function showCustomConfirm(title, message, onConfirm) {
        document.getElementById('confirm-modal-title').innerText = title;
        document.getElementById('confirm-modal-msg').innerText = message;
        confirmCallback = onConfirm;
        document.getElementById('confirm-modal').classList.add('active');
    }

    function closeConfirmModal() {
        document.getElementById('confirm-modal').classList.remove('active');
        confirmCallback = null;
    }

    document.getElementById('confirm-modal-btn-yes').addEventListener('click', function() {
        if (confirmCallback) confirmCallback();
        closeConfirmModal();
    });

    function copyMainLoader() {
        const text = document.getElementById('main-hub-loader').innerText;
        navigator.clipboard.writeText(text).then(() => {
            showToast("Đã sao chép mã Loader Hub thành công!", "success");
        }).catch(err => {
            console.error("Lỗi sao chép:", err);
            showToast("Không thể sao chép script!", "error");
        });
    }

    function copyScriptContent(tIdx, sIdx, e) {
        if (e) e.stopPropagation();
        const content = hubData.Tabs[tIdx].StandaloneScripts[sIdx].Content;
        if (!content) return showToast("Script này không có nội dung!", "error");
        navigator.clipboard.writeText(content).then(() => {
            showToast("Đã sao chép mã Script!", "success");
        }).catch(err => {
            console.error("Lỗi sao chép:", err);
            showToast("Không thể sao chép script!", "error");
        });
    }

    async function loadDataFromServer() {
        try {
            const response = await fetch('/raw-hub?t=' + Date.now());
            if (response.ok) {
                hubData = await response.json();
                document.getElementById('hub-name').value = hubData.Info?.Name || "";
                document.getElementById('hub-version').value = hubData.Info?.Version || "";
                document.getElementById('hub-intro').value = hubData.HomeTab?.Introduction || "";
                
                updateStats();
                renderTabsTree();
                updateTabSelectOptions();
            } else {
                showToast("Không thể lấy dữ liệu từ server!", "error");
            }
        } catch (error) {
            console.error("Lỗi kết nối:", error);
            showToast("Lỗi kết nối đến máy chủ!", "error");
        }
    }

    function updateStats() {
        const totalTabs = hubData.Tabs ? hubData.Tabs.length : 0;
        let totalScripts = 0;
        if (hubData.Tabs) {
            hubData.Tabs.forEach(tab => {
                if (tab.StandaloneScripts) totalScripts += tab.StandaloneScripts.length;
            });
        }
        document.getElementById('stat-total-tabs').innerText = totalTabs;
        document.getElementById('stat-total-scripts').innerText = totalScripts;
    }

    function toggleInputMode() {
        const mode = document.getElementById('input-mode').value;
        document.getElementById('manual-input-block').style.display = (mode === 'manual') ? 'block' : 'none';
        document.getElementById('syntax-input-block').style.display = (mode === 'syntax') ? 'block' : 'none';
        document.getElementById('scriptblox-input-block').style.display = (mode === 'scriptblox') ? 'block' : 'none';
    }

    function toggleAddFields() {
        const type = document.getElementById('add-type').value;
        document.getElementById('field-tab-name').style.display = (type === 'tab') ? 'block' : 'none';
        document.getElementById('script-fields').style.display = (type === 'script') ? 'block' : 'none';
    }

    function toggleSbDegree() {
        const deg = document.getElementById('sb-mode-degree').value;
        document.getElementById('sb-single-input-wrapper').style.display = (deg === '1') ? 'block' : 'none';
        document.getElementById('sb-multi-input-wrapper').style.display = (deg === '2') ? 'block' : 'none';
    }

    function updateTabSelectOptions() {
        const selectManual = document.getElementById('target-tab-select');
        const selectGlobal = document.getElementById('sb-global-target-tab');
        
        selectManual.innerHTML = "";
        selectGlobal.innerHTML = "";

        if (!hubData.Tabs || hubData.Tabs.length === 0) {
            let opt1 = document.createElement('option');
            opt1.value = ""; opt1.innerText = "-- Chưa có Tab nào --";
            selectManual.appendChild(opt1);

            let opt2 = document.createElement('option');
            opt2.value = ""; opt2.innerText = "-- Chưa có Tab nào --";
            selectGlobal.appendChild(opt2);
            return;
        }

        hubData.Tabs.forEach((tab, index) => {
            let opt1 = document.createElement('option');
            opt1.value = index;
            opt1.innerText = tab.Name;
            selectManual.appendChild(opt1);

            let opt2 = document.createElement('option');
            opt2.value = index;
            opt2.innerText = tab.Name;
            selectGlobal.appendChild(opt2);
        });

        // Cập nhật lại dropdown trong danh sách preview nếu có
        renderFetchedItemsContainer();
    }

    function addNewElement() {
        const type = document.getElementById('add-type').value;

        if (type === 'tab') {
            const name = document.getElementById('new-tab-name').value.trim();
            if (!name) return showToast("Vui lòng nhập tên Tab!", "error");
            hubData.Tabs.push({ Name: name, Sections: [], StandaloneScripts: [] });
            document.getElementById('new-tab-name').value = "";
            showToast(`Đã tạo Tab "${name}" thành công!`, "success");
            switchTab('dashboard');
        } else {
            const tabIdx = document.getElementById('target-tab-select').value;
            if (tabIdx === "" || tabIdx === null) return showToast("Vui lòng chọn Tab trước!", "error");
            
            const name = document.getElementById('new-script-name').value.trim();
            const desc = document.getElementById('new-script-desc').value.trim();
            const content = document.getElementById('new-script-content').value.trim();

            if (!name || !content) return showToast("Vui lòng điền đầy đủ tên và mã script!", "error");

            if (!hubData.Tabs[tabIdx].StandaloneScripts) hubData.Tabs[tabIdx].StandaloneScripts = [];
            hubData.Tabs[tabIdx].StandaloneScripts.push({ Name: name, Desc: desc, Content: content });

            document.getElementById('new-script-name').value = "";
            document.getElementById('new-script-desc').value = "";
            document.getElementById('new-script-content').value = "";
            showToast(`Đã thêm Script "${name}"!`, "success");
            switchTab('dashboard');
        }

        updateStats();
        renderTabsTree();
        updateTabSelectOptions();
    }

    function parseSyntaxInput() {
        const text = document.getElementById('syntax-code').value.trim();
        if (!text) return showToast("Vui lòng nhập lệnh cú pháp!", "error");

        const lines = text.split('\n');
        let successCount = 0;

        lines.forEach(line => {
            line = line.trim();
            if (line.startsWith('/t/')) {
                const tabName = line.substring(3).trim();
                if (tabName) {
                    let exists = hubData.Tabs.find(t => t.Name.toLowerCase() === tabName.toLowerCase());
                    if (!exists) {
                        hubData.Tabs.push({ Name: tabName, Sections: [], StandaloneScripts: [] });
                    }
                    successCount++;
                }
            } else if (line.startsWith('/s/')) {
                const parts = line.substring(3).split('/');
                if (parts.length >= 4) {
                    const scriptName = parts[0].trim();
                    const scriptDesc = parts[1].trim();
                    const scriptContent = parts[2].trim();
                    const tabTargetName = parts[3].trim();

                    let targetTab = hubData.Tabs.find(t => t.Name.toLowerCase() === tabTargetName.toLowerCase());
                    if (!targetTab) {
                        targetTab = { Name: tabTargetName, Sections: [], StandaloneScripts: [] };
                        hubData.Tabs.push(targetTab);
                    }

                    if (!targetTab.StandaloneScripts) targetTab.StandaloneScripts = [];
                    targetTab.StandaloneScripts.push({
                        Name: scriptName,
                        Desc: scriptDesc,
                        Content: scriptContent
                    });
                    successCount++;
                }
            }
        });

        document.getElementById('syntax-code').value = "";
        updateStats();
        renderTabsTree();
        updateTabSelectOptions();
        showToast(`Đã phân tích thành công ${successCount} mục!`, "success");
        switchTab('dashboard');
    }

    // SCRIPTBLOX MULTI-LINK FETCH LOGIC (CHUẨN 6 PROXY HOẶC NHANH 1 PROXY)
    async function fetchOneScriptblox(rawUrl, mode) {
        let scriptId = rawUrl.trim();
        if (scriptId.includes('scriptblox.com/script/')) {
            const parts = scriptId.split('scriptblox.com/script/')[1].split('?')[0].split('/');
            scriptId = parts[0];
        }
        if (!scriptId) return null;

        const targetApiUrl = `https://scriptblox.com/api/script/${scriptId}`;
        const proxies = mode === 'standard' ? [
            url => `https://api.allorigins.win/raw?url=${encodeURIComponent(url)}`,
            url => `https://corsproxy.io/?${encodeURIComponent(url)}`,
            url => `https://api.codetabs.com/v1/proxy?quest=${encodeURIComponent(url)}`,
            url => `https://thingproxy.freeboard.io/fetch/${url}`,
            url => `https://jsonp.afeld.me/?url=${encodeURIComponent(url)}`,
            url => url
        ] : [
            url => `https://api.allorigins.win/raw?url=${encodeURIComponent(url)}` // 1 proxy cho chế độ nhanh
        ];

        for (let i = 0; i < proxies.length; i++) {
            try {
                const proxyUrl = proxies[i](targetApiUrl);
                const response = await fetch(proxyUrl, { headers: { 'Accept': 'application/json' } });
                if (response.ok) {
                    const responseText = await response.text();
                    let parsedJson = null;
                    try {
                        parsedJson = JSON.parse(responseText);
                    } catch(e) {
                        try {
                            const wrapped = JSON.parse(responseText);
                            if (wrapped.contents) parsedJson = JSON.parse(wrapped.contents);
                        } catch(err2) {}
                    }

                    if (parsedJson && (parsedJson.script || parsedJson.title)) {
                        const data = parsedJson.script || parsedJson;
                        return {
                            Name: data.title || "Scriptblox Script",
                            Desc: data.features || (data.game?.name ? `Game: ${data.game.name}` : "Được bóc tách từ Scriptblox"),
                            Content: data.script || data.rawScript || "",
                            TargetTab: 0
                        };
                    }
                }
            } catch (err) {}
        }
        return null;
    }

    async function fetchFromScriptblox(mode) {
        const degree = document.getElementById('sb-mode-degree').value;
        const statusBox = document.getElementById('sb-status-box');
        statusBox.style.display = "block";

        let urls = [];
        if (degree === '1') {
            const single = document.getElementById('scriptblox-url').value.trim();
            if (!single) return showToast("Vui lòng dán Link hoặc ID Scriptblox!", "error");
            urls = [single];
        } else {
            const rawMulti = document.getElementById('scriptblox-multi-urls').value.trim();
            if (!rawMulti) return showToast("Vui lòng dán danh sách Link!", "error");
            // Phân tách bằng xuống dòng hoặc dấu ;
            urls = rawMulti.split(/[\n;]+/).map(u => u.trim()).filter(u => u.length > 0);
            if (urls.length > 10) {
                showToast("Giới hạn tối đa 10 link mỗi lần quét!", "error");
                urls = urls.slice(0, 10);
            }
        }

        statusBox.className = "alert alert-info py-2 px-3 mb-3 font-monospace fs-6";
        statusBox.innerText = `⏳ Đang xử lý bóc tách ${urls.length} link (${mode === 'standard' ? 'Chuẩn - 6 Proxy' : 'Nhanh - 1 Proxy'})...`;

        fetchedScriptbloxItems = [];
        for (let idx = 0; idx < urls.length; idx++) {
            statusBox.innerText = `⏳ Đang tải link ${idx + 1}/${urls.length}...`;
            const result = await fetchOneScriptblox(urls[idx], mode);
            if (result) {
                fetchedScriptbloxItems.push(result);
            }
        }

        if (fetchedScriptbloxItems.length === 0) {
            statusBox.className = "alert alert-danger py-2 px-3 mb-3 font-monospace fs-6";
            statusBox.innerText = "❌ Không thể bóc tách dữ liệu từ các link đã nhập. Vui lòng kiểm tra lại!";
            showToast("Bóc tách thất bại!", "error");
            return;
        }

        statusBox.className = "alert alert-success py-2 px-3 mb-3 font-monospace fs-6";
        statusBox.innerText = `✅ Đã bóc tách thành công ${fetchedScriptbloxItems.length} script! Kiểm tra bên dưới để chỉnh sửa.`;

        renderFetchedItemsContainer();
        document.getElementById('scriptblox-preview-card').style.display = "block";
        showToast(`Đã lấy thành công ${fetchedScriptbloxItems.length} script!`, "success");
    }

    function renderFetchedItemsContainer() {
        const container = document.getElementById('sb-fetched-items-container');
        container.innerHTML = "";

        if (!hubData.Tabs || hubData.Tabs.length === 0) {
            container.innerHTML = "<div class='text-danger'>Cảnh báo: Bạn chưa tạo Tab nào! Hãy tạo Tab trước khi thêm script.</div>";
            return;
        }

        fetchedScriptbloxItems.forEach((item, index) => {
            let tabOptionsHtml = "";
            hubData.Tabs.forEach((tab, tIdx) => {
                const selected = item.TargetTab === tIdx ? "selected" : "";
                tabOptionsHtml += `<option value="${tIdx}" ${selected}>${tab.Name}</option>`;
            });

            let box = document.createElement('div');
            box.className = "p-3 rounded border border-secondary";
            box.style.background = "rgba(10, 15, 29, 0.9)";
            box.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong class="text-primary-cyan">#${index + 1} Script Preview</strong>
                    <button class="btn btn-sm btn-outline-danger py-0 px-2" onclick="removeFetchedItem(${index})"><i class="fa-solid xmark"></i> Xóa</button>
                </div>
                <div class="mb-2">
                    <label class="form-label-custom">Chọn Tab Mục Tiêu:</label>
                    <select class="form-select-custom sb-item-tab" data-index="${index}">${tabOptionsHtml}</select>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="form-label-custom">Tên Script</label>
                        <input type="text" class="form-control-custom sb-item-name" data-index="${index}" value="${item.Name.replace(/"/g, '&quot;')}">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-custom">Mô tả</label>
                        <input type="text" class="form-control-custom sb-item-desc" data-index="${index}" value="${item.Desc.replace(/"/g, '&quot;')}">
                    </div>
                </div>
                <div>
                    <label class="form-label-custom">Mã Code</label>
                    <textarea class="form-control-custom sb-item-content" data-index="${index}" rows="3">${item.Content}</textarea>
                </div>
            `;
            container.appendChild(box);
        });
    }

    function removeFetchedItem(index) {
        fetchedScriptbloxItems.splice(index, 1);
        renderFetchedItemsContainer();
        if (fetchedScriptbloxItems.length === 0) {
            document.getElementById('scriptblox-preview-card').style.display = "none";
        }
    }

    function applyGlobalTabToAll() {
        const globalTabIdx = document.getElementById('sb-global-target-tab').value;
        if (globalTabIdx === "" || globalTabIdx === null) return showToast("Chưa chọn Tab áp dụng chung!", "error");
        
        fetchedScriptbloxItems.forEach((item) => {
            item.TargetTab = parseInt(globalTabIdx);
        });
        renderFetchedItemsContainer();
        showToast("Đã áp dụng Tab chung cho tất cả!", "success");
    }

    function confirmAddAllScriptblox() {
        if (fetchedScriptbloxItems.length === 0) return showToast("Không có script nào để thêm!", "error");

        // Cập nhật lại giá trị user sửa từ form UI vào mảng tạm
        document.querySelectorAll('.sb-item-name').forEach(input => {
            const idx = input.getAttribute('data-index');
            fetchedScriptbloxItems[idx].Name = input.value.trim();
        });
        document.querySelectorAll('.sb-item-desc').forEach(input => {
            const idx = input.getAttribute('data-index');
            fetchedScriptbloxItems[idx].Desc = input.value.trim();
        });
        document.querySelectorAll('.sb-item-content').forEach(textarea => {
            const idx = textarea.getAttribute('data-index');
            fetchedScriptbloxItems[idx].Content = textarea.value.trim();
        });
        document.querySelectorAll('.sb-item-tab').forEach(select => {
            const idx = select.getAttribute('data-index');
            fetchedScriptbloxItems[idx].TargetTab = parseInt(select.value);
        });

        let addedCount = 0;
        fetchedScriptbloxItems.forEach(item => {
            const tIdx = item.TargetTab;
            if (tIdx !== undefined && hubData.Tabs[tIdx]) {
                if (!hubData.Tabs[tIdx].StandaloneScripts) hubData.Tabs[tIdx].StandaloneScripts = [];
                hubData.Tabs[tIdx].StandaloneScripts.push({
                    Name: item.Name || "Scriptblox Script",
                    Desc: item.Desc || "",
                    Content: item.Content || ""
                });
                addedCount++;
            }
        });

        document.getElementById('scriptblox-preview-card').style.display = "none";
        document.getElementById('sb-status-box').style.display = "none";
        fetchedScriptbloxItems = [];

        updateStats();
        renderTabsTree();
        showToast(`🎉 Đã thêm thành công ${addedCount} script vào Hub!`, "success");
        switchTab('dashboard');
    }

    function deleteTab(tabIndex, e) {
        if (e) e.stopPropagation();
        const tabName = hubData.Tabs[tabIndex]?.Name || "";
        showCustomConfirm("Xóa Tab", `Bạn có chắc chắn muốn xóa Tab "${tabName}" và toàn bộ script bên trong không?`, function() {
            hubData.Tabs.splice(tabIndex, 1);
            updateStats();
            renderTabsTree();
            updateTabSelectOptions();
            showToast("Đã xóa Tab thành công!", "info");
        });
    }

    function deleteScript(tabIndex, scriptIndex, e) {
        if (e) e.stopPropagation();
        showCustomConfirm("Xóa Script", "Bạn có chắc chắn muốn xóa Script này khỏi Tab?", function() {
            hubData.Tabs[tabIndex].StandaloneScripts.splice(scriptIndex, 1);
            updateStats();
            renderTabsTree();
            showToast("Đã xóa Script thành công!", "info");
        });
    }

    function openEditScriptModal(tIdx, sIdx, e) {
        if (e) e.stopPropagation();
        const script = hubData.Tabs[tIdx].StandaloneScripts[sIdx];
        document.getElementById('edit-tab-idx').value = tIdx;
        document.getElementById('edit-script-idx').value = sIdx;
        document.getElementById('edit-script-name').value = script.Name || "";
        document.getElementById('edit-script-desc').value = script.Desc || "";
        document.getElementById('edit-script-content').value = script.Content || "";
        document.getElementById('edit-modal').classList.add('active');
    }

    function closeEditModal() {
        document.getElementById('edit-modal').classList.remove('active');
    }

    function saveEditScript() {
        const tIdx = document.getElementById('edit-tab-idx').value;
        const sIdx = document.getElementById('edit-script-idx').value;

        const name = document.getElementById('edit-script-name').value.trim();
        const desc = document.getElementById('edit-script-desc').value.trim();
        const content = document.getElementById('edit-script-content').value.trim();

        if (!name || !content) return showToast("Tên và Nội dung không được để trống!", "error");

        hubData.Tabs[tIdx].StandaloneScripts[sIdx] = { Name: name, Desc: desc, Content: content };
        closeEditModal();
        renderTabsTree();
        showToast("Đã lưu cập nhật Script!", "success");
    }

    function toggleTabCollapse(tIdx, e) {
        if (e) e.stopPropagation();
        tabCollapsedState[tIdx] = !tabCollapsedState[tIdx];
        renderTabsTree();
    }

    function toggleAllTabs(collapsed) {
        if (hubData.Tabs) {
            hubData.Tabs.forEach((_, idx) => {
                tabCollapsedState[idx] = collapsed;
            });
        }
        renderTabsTree();
    }

    function toggleDescExpand(key, e) {
        if (e) e.stopPropagation();
        descExpandedState[key] = !descExpandedState[key];
        renderTabsTree();
    }

    function onSearchInput() {
        searchQuery = document.getElementById('search-script-input').value.toLowerCase().trim();
        renderTabsTree();
    }

    function renderTabsTree() {
        const container = document.getElementById('tabs-tree-container');
        container.innerHTML = "";

        if (!hubData.Tabs || hubData.Tabs.length === 0) {
            container.innerHTML = "<p style='color: #8b949e; text-align:center; padding: 24px 0;'>Chưa có Tab Script nào được tạo.</p>";
            return;
        }

        let hasVisibleItems = false;

        hubData.Tabs.forEach((tab, tIdx) => {
            const isTabMatch = tab.Name.toLowerCase().includes(searchQuery);

            let matchingScripts = [];
            if (tab.StandaloneScripts) {
                matchingScripts = tab.StandaloneScripts.filter(s => 
                    s.Name.toLowerCase().includes(searchQuery) || 
                    (s.Desc && s.Desc.toLowerCase().includes(searchQuery))
                );
            }

            if (searchQuery && !isTabMatch && matchingScripts.length === 0) {
                return;
            }

            hasVisibleItems = true;
            const isCollapsed = searchQuery ? false : (tabCollapsedState[tIdx] || false);
            const scriptCount = tab.StandaloneScripts ? tab.StandaloneScripts.length : 0;

            let tabDiv = document.createElement('div');
            tabDiv.className = 'tab-item-box';
            
            tabDiv.innerHTML = `
                <div class="tab-header-bar" onclick="toggleTabCollapse(${tIdx}, event)">
                    <div class="d-flex align-items-center gap-2">
                        <span class="collapse-indicator ${isCollapsed ? 'collapsed' : ''}"><i class="fa-solid fa-chevron-down"></i></span>
                        <strong style="color: #f8fafc; font-size: 15.5px;"><i class="fa-solid fa-folder me-1 text-warning"></i> Tab: ${tab.Name}</strong>
                        <span style="font-size:12px; color: var(--text-muted); background: rgba(255,255,255,0.08); padding: 3px 10px; border-radius: 12px; font-weight: 600;">${scriptCount} Script</span>
                    </div>
                    <button class="btn-custom btn-danger-custom" style="padding:6px 14px; font-size:12.5px;" onclick="deleteTab(${tIdx}, event)">
                        <i class="fa-solid fa-trash-can"></i> Xóa Tab
                    </button>
                </div>
                <div class="item-list-container ${isCollapsed ? 'hidden-list' : ''}" id="scripts-of-tab-${tIdx}"></div>
            `;
            container.appendChild(tabDiv);

            const scriptListContainer = document.getElementById(`scripts-of-tab-${tIdx}`);
            const scriptsToDisplay = searchQuery ? (isTabMatch ? tab.StandaloneScripts : matchingScripts) : tab.StandaloneScripts;
            
            if (scriptsToDisplay && scriptsToDisplay.length > 0) {
                scriptsToDisplay.forEach((script) => {
                    const sIdx = tab.StandaloneScripts.indexOf(script);
                    const descKey = `${tIdx}-${sIdx}`;
                    const isDescExpanded = descExpandedState[descKey] || false;

                    const descText = script.Desc || "Không có mô tả";
                    const isLongDesc = descText.length > 95;

                    let scriptDiv = document.createElement('div');
                    scriptDiv.className = 'script-card-item';
                    scriptDiv.onclick = function(e) {
                        openEditScriptModal(tIdx, sIdx, e);
                    };
                    scriptDiv.innerHTML = `
                        <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-2">
                            <div><i class="fa-solid fa-scroll text-info me-1"></i> Script: <strong style="color: var(--primary-cyan); font-size: 15px;">${script.Name}</strong></div>
                            <div class="script-actions">
                                <button class="btn-custom btn-success-custom" style="padding:5px 12px; font-size:12.5px;" onclick="copyScriptContent(${tIdx}, ${sIdx}, event)">
                                    <i class="fa-regular fa-copy"></i> Copy
                                </button>
                                <button class="btn-custom btn-warning-custom" style="padding:5px 12px; font-size:12.5px;" onclick="openEditScriptModal(${tIdx}, ${sIdx}, event)">
                                    <i class="fa-solid fa-pen"></i> Sửa
                                </button>
                                <button class="btn-custom btn-danger-custom" style="padding:5px 12px; font-size:12.5px;" onclick="deleteScript(${tIdx}, ${sIdx}, event)">
                                    <i class="fa-solid fa-trash-can"></i> Xóa
                                </button>
                            </div>
                        </div>
                        <div class="desc-text-box ${!isDescExpanded && isLongDesc ? 'truncated' : ''}">
                            <i class="fa-regular fa-file-lines me-1"></i> Mô tả: ${descText}
                        </div>
                        ${isLongDesc ? `<button class="btn-expand-desc" onclick="toggleDescExpand('${descKey}', event)">${isDescExpanded ? '▲ Thu gọn mô tả' : '▼ Xem đầy đủ mô tả'}</button>` : ''}
                    `;
                    scriptListContainer.appendChild(scriptDiv);
                });
            } else {
                scriptListContainer.innerHTML = "<p style='color: #6e7681; font-size: 13.5px; margin: 8px 0;'><i class='fa-solid fa-circle-exclamation me-1'></i> Tab này chưa chứa Script nào.</p>";
            }
        });

        if (!hasVisibleItems && searchQuery) {
            container.innerHTML = `<p style='color: #8b949e; text-align:center; padding: 24px 0;'><i class='fa-solid fa-magnifying-glass me-1'></i> Không tìm thấy Tab hoặc Script khớp với từ khóa "${searchQuery}".</p>`;
        }
    }

    async function saveDataToServer() {
        hubData.Info.Name = document.getElementById('hub-name').value.trim();
        hubData.Info.Version = document.getElementById('hub-version').value.trim();
        hubData.HomeTab.Introduction = document.getElementById('hub-intro').value.trim();

        try {
            const response = await fetch('/save-hub', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(hubData)
            });

            const result = await response.json();
            if (response.ok && result.success) {
                showToast("🎉 Đã lưu và đồng bộ trực tiếp lên GitHub thành công!", "success");
                await loadDataFromServer();
            } else {
                showToast("Lỗi lưu file: " + (result.message || "Từ chối kết nối"), "error");
            }
        } catch (error) {
            showToast("Không thể kết nối đến máy chủ Render!", "error");
            console.error(error);
        }
    }
</script>

</body>
</html>
